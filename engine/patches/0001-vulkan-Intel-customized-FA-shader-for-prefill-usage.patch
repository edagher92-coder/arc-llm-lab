+          [[unroll]] for (uint cc = 0; cc < MAT_P_COUNT; cc++) {
+            coopMatLoad(
+              matK[cc],
+              slm_pool_f16.slm_pool_f16,
+              SLM_OFFSET_BASE_K + MAT_Q_COUNT * TK * DP + DP * TK * dd + TM * TK * cc,
+              TK,
+              gl_CooperativeMatrixLayoutRowMajor);
+          }
+
+          coopMatLoad(
+            matQSlm,
+            slm_pool_f16.slm_pool_f16,
+            SLM_OFFSET_BASE_Q + localLinearId * TN * Q_MAT_IN_SLM + TK * dd,
+            Q_MAT_IN_SLM,
+            gl_CooperativeMatrixLayoutColumnMajor);
+
+          [[unroll]] for (uint cc = 0; cc < MAT_P_COUNT; cc++) {
+            matP[cc] = coopMatMulAdd(matK[cc], matQSlm, matP[cc]);
+          }
+        }
+
+        [[unroll]] for (uint cc = 0; cc < MAT_P_COUNT; cc++) {
+          coopMatStore(matP[cc], slm_pool_float.slm_pool_f32, SLM_OFFSET_BASE_P + 8 * cc + localLinearId * TN * DP, DP, gl_CooperativeMatrixLayoutColumnMajor);
+        }
+      }
+
+      subgroupBarrier();
+
+      float matPSoftmax[DP];
+      float localMax = historicMax;
+      float softmaxCompensation;
+
+      [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+        matPSoftmax[cc] = slm_pool_float.slm_pool_f32[offsetLoadSlmP + cc];
+      }
+
+      if (MASK_IN_SLM) {
+        [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+          matPSoftmax[cc] = matPSoftmax[cc] + float(slm_pool_f16.slm_pool_f16[offsetSlmLoadMaskP + cc]);
+        }
+      } else {
+        if ((EXT_FLAG & UNALIGNED_MASK_DIM) != 0) {
+          [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+            if (loop * DP + cc < maskDim) {
+              matPSoftmax[cc] = matPSoftmax[cc] + float(mState[offsetBaseMask]);
+              offsetBaseMask = offsetBaseMask + 1;
+            } else {
+              matPSoftmax[cc] = matPSoftmax[cc] + fp32Min;
+            }
+          }
+        } else {
+          [[unroll]] for (uint cc = 0; cc < DP / 4; cc++) {
+            f16vec4 f16MaskTemp = mStateVec4[offsetBaseMask];
+            float f32MaskTemp[4] = float[4](float(f16MaskTemp.x), float(f16MaskTemp.y), float(f16MaskTemp.z), float(f16MaskTemp.w));
+            [[unroll]] for (uint kk = 0; kk < 4; kk++) {
+              matPSoftmax[4 * cc + kk] = matPSoftmax[4 * cc + kk] + f32MaskTemp[kk];
+            }
+            offsetBaseMask = offsetBaseMask + 1;
+          }
+        }
+      }
+
+      [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+        localMax = max(localMax, matPSoftmax[cc]);
+      }
+
+      [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+        matPSoftmax[cc] = matPSoftmax[cc] - localMax;
+      }
+
+      [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+        matPSoftmax[cc] = exp(matPSoftmax[cc]);
+      }
+
+      softmaxCompensation = exp(historicMax - localMax);
+      softmaxSum = softmaxSum * softmaxCompensation;
+      [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+        softmaxSum += matPSoftmax[cc];
+      }
+      slm_pool_float.slm_pool_f32[SLM_OFFSET_COMPENSATION + localLinearId * TN + lane] = softmaxCompensation;
+      [[unroll]] for (uint cc = 0; cc < DP; cc++) {
+        slm_pool_f16.slm_pool_f16[offsetLoadSlmP * 2 + cc] = float16_t(matPSoftmax[cc]);
+      }
+      historicMax = localMax;
+    }
+
+    if ((QK_SUBGROUPS == SUBGROUP_COUNT) || (localLinearId >= SUBGROUP_COUNT - V_LOAD_SUBGROUPS)) {
+      if (LOAD_V_BOUNDARY_CHECK) {
+        [[unroll]] for (uint vLoad = 0; vLoad < LOAD_V_LOOPS - 1; vLoad++) {
+          coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matVTemp;
+          coopMatLoad(
+            matVTemp,
+            vState,
+            offsetBaseV + TM * vLoad * LOAD_V_HORIZONTAL_GROUPS,
+            vDim,
+            gl_CooperativeMatrixLayoutColumnMajor);
+
+          coopMatStore(
+            matVTemp,
+            slm_pool_f16.slm_pool_f16,
+            offsetSlmV + TM * vLoad * TK * LOAD_V_HORIZONTAL_GROUPS,
+            TK,
+            gl_CooperativeMatrixLayoutRowMajor);
+        }
+
+        if ((hhv + (LOAD_V_LOOPS - 1) * LOAD_V_HORIZONTAL_GROUPS) * TM < HEAD_DIM_PV) {
+          coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matVTemp;
+          coopMatLoad(
+            matVTemp,
+            vState,
+            offsetBaseV + TM * (LOAD_V_LOOPS - 1) * LOAD_V_HORIZONTAL_GROUPS,
+            vDim,
+            gl_CooperativeMatrixLayoutColumnMajor);
+
+          coopMatStore(
+            matVTemp,
+            slm_pool_f16.slm_pool_f16,
+            offsetSlmV + TM * (LOAD_V_LOOPS - 1) * TK * LOAD_V_HORIZONTAL_GROUPS,
+            TK,
+            gl_CooperativeMatrixLayoutRowMajor);
+        }
+      } else {
+        [[unroll]] for (uint vLoad = 0; vLoad < LOAD_V_LOOPS; vLoad++) {
+          coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matVTemp;
+          coopMatLoad(
+            matVTemp,
+            vState,
+            offsetBaseV + TM * vLoad * LOAD_V_HORIZONTAL_GROUPS,
+            vDim,
+            gl_CooperativeMatrixLayoutColumnMajor);
+
+          coopMatStore(
+            matVTemp,
+            slm_pool_f16.slm_pool_f16,
+            offsetSlmV + TM * vLoad * TK * LOAD_V_HORIZONTAL_GROUPS,
+            TK,
+            gl_CooperativeMatrixLayoutRowMajor);
+        }
+      }
+    }
+
+    barrier();
+    {
+      const uint coopMatPBase = SLM_OFFSET_BASE_P * 2 + vvo * TN * DP * 2;
+      const uint coopMatVBase = SLM_OFFSET_BASE_V + hho * MAT_O_COUNT * TM * TK;
+      float compensationO = slm_pool_float.slm_pool_f32[SLM_OFFSET_COMPENSATION + vvo * TN + lane];
+      [[unroll]] for (uint oLoop = 0; oLoop < MAT_O_COUNT / MAT_ACC_COUNT; oLoop++) {
+        coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[MAT_ACC_COUNT];
+        coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matV[MAT_ACC_COUNT];
+        [[unroll]] for (uint cc = 0; cc < MAT_ACC_COUNT; cc++) {
+          acc[cc] = coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);
+        }
+
+        [[unroll]] for (uint dd = 0; dd < DP / TK; dd++) {
+          coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> matPTemp;
+          coopMatLoad(
+            matPTemp,
+            slm_pool_f16.slm_pool_f16,
+            coopMatPBase + TK * dd,
+            2 * DP,
+            gl_CooperativeMatrixLayoutColumnMajor);
+
+          [[unroll]] for (uint cc = 0; cc < MAT_ACC_COUNT; cc++) {
+            coopMatLoad(
+              matV[cc],
+              slm_pool_f16.slm_pool_f16,
+              coopMatVBase + oLoop * MAT_ACC_COUNT * TM * TK + HEAD_DIM_PV * TK * dd + TM * TK * cc,
+              TK,
+              gl_CooperativeMatrixLayoutRowMajor);
+          }
+
+          [[unroll]] for (uint cc = 0; cc < MAT_ACC_COUNT; cc++) {
+            acc[cc] = coopMatMulAdd(matV[cc], matPTemp, acc[cc]);
+          }
+        }
+
+        [[unroll]] for (uint cc = 0; cc < MAT_ACC_COUNT; cc++) {
+          coopMatStore(
+            acc[cc],
+            slm_pool_float.slm_pool_f32,
+            SLM_OFFSET_BASE_ACC + TM * cc + localLinearId * MAT_ACC_COUNT * TN * TM,
+            MAT_ACC_COUNT * TM,
+            gl_CooperativeMatrixLayoutColumnMajor);
+        }
+
+        subgroupBarrier();
+
+        [[unroll]] for (uint cc = 0; cc < MAT_ACC_COUNT * TM; cc++) {
+          fp32Out[oLoop * MAT_ACC_COUNT * TM + cc] = fma(fp32Out[oLoop * MAT_ACC_COUNT * TM + cc], compensationO, slm_pool_float.slm_pool_f32[SLM_OFFSET_BASE_ACC + localLinearId * MAT_ACC_COUNT * TN * TM + lane * MAT_ACC_COUNT * TM + cc]);
+        }
+      }
+    }
+
+    uint kvCoord = vvv * TK + loop * DP;
+    offsetBaseV = offsetBaseV + vDim * DP;
+    offsetBaseV = kvCoord >= p.kvSeqLen ? 0 : offsetBaseV;
+    barrier();
+  }
+
+  if (localLinearId < QK_SUBGROUPS) {
+    slm_pool_float.slm_pool_f32[localLinearId * TN + lane] = historicMax;
+    slm_pool_float.slm_pool_f32[QK_SUBGROUPS * TN + localLinearId * TN + lane] = softmaxSum;
+  }
+
+  barrier();
+
+  historicMax = slm_pool_float.slm_pool_f32[vvo * TN + lane];
+  softmaxSum = slm_pool_float.slm_pool_f32[QK_SUBGROUPS * TN + vvo * TN + lane];
+
+  float softmaxMul;
+  if (0x1 == (p.flag & 0x1)) {
+    float sinkCompensation = historicMax - fp32SinkCoeff;
+    sinkCompensation = exp(sinkCompensation);
+    float softmaxSumTemp = softmaxSum * sinkCompensation;
+    softmaxSum = softmaxSum + 1.0f / sinkCompensation;
+    softmaxSum = 1.0f / softmaxSum;
+    sinkCompensation = sinkCompensation / (1.0f + softmaxSumTemp);
+    softmaxMul = historicMax < fp32SinkCoeff ? sinkCompensation : softmaxSum;
+  } else {
+    softmaxMul = 1.0f / softmaxSum;
+  }
+
+  [[unroll]] for (uint cc = 0; cc < OUTPUT_DIM_PER_WARP; cc++) {
+    fp32Out[cc] = fp32Out[cc] * softmaxMul;
+  }
+
+  uint offsetCoord = outIdx * OUTPUT_PER_WORK_GROUP + vvo * TN + lane;
+  [[unroll]] for (uint cc = 0; cc < OUTPUT_DIM_PER_WARP / 4; cc++) {
+    const uint outDimCoord = 4 * cc + hho * OUTPUT_DIM_PER_WARP;
+    if (offsetCoord < p.activationLength && outDimCoord < HEAD_DIM_PV) {
+      attnOutVec4[offsetOut + cc] = vec4(fp32Out[4 * cc], fp32Out[4 * cc + 1], fp32Out[4 * cc + 2], fp32Out[4 * cc + 3]);
+    }
+  }
+}
