+#define SLM_POOL_SIZE_Q (OUTPUT_PER_WORK_GROUP * Q_MAT_IN_SLM)
+#define SLM_POOL_SIZE_K (LOAD_K_LOOPS * LOAD_K_PER_LOOP)
+#define SLM_POOL_SIZE_V (DP * HEAD_DIM_PV)
+#define SLM_POOL_SIZE_M (OUTPUT_PER_WORK_GROUP * DP)
+#define SLM_POOL_SIZE_COMPENSATION (OUTPUT_PER_WORK_GROUP)
+#define SLM_POOL_SIZE_ACC (MAT_ACC_COUNT * TM * TN * SUBGROUP_COUNT)
+
+#define SLM_OFFSET_BASE_Q 0
+#define SLM_OFFSET_COMPENSATION ((SLM_OFFSET_BASE_Q + SLM_POOL_SIZE_Q) / 2)
+#define SLM_OFFSET_BASE_V ((SLM_OFFSET_COMPENSATION + SLM_POOL_SIZE_COMPENSATION) * 2)
+#define SLM_OFFSET_BASE_P ((SLM_OFFSET_BASE_V + SLM_POOL_SIZE_V) / 2)
+#define SLM_OFFSET_BASE_K ((SLM_OFFSET_BASE_P + SLM_POOL_SIZE_P) * 2)
+#define SLM_OFFSET_BASE_ACC (SLM_OFFSET_BASE_K / 2)
+#define SLM_OFFSET_BASE_M (SLM_OFFSET_BASE_K + SLM_POOL_SIZE_K)
+
+#define MASK_IN_SLM (OUTPUT_PER_WORK_GROUP < GROUPSIZE)
+
+#define OUTPUT_VERTICAL_GROUPS QK_SUBGROUPS
+#define OUTPUT_HORIZONTAL_GROUPS (HEAD_DIM_PV / OUTPUT_DIM_PER_WARP)
+
+shared slm_pool_block {
+  float slm_pool_f32[TOTAL_SLM_IN_BYTE / 4];
