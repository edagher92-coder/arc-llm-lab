+void main() {
+  const uint lane = gl_SubgroupInvocationID;
+  const uint headIdx = gl_WorkGroupID.x;
+  const uint kvHeadIdx = headIdx / GQA_RATIO;
+  const uint outIdx = gl_WorkGroupID.y;
+  const uint batchIdx =  gl_WorkGroupID.z;
+  const uint localLinearId = gl_SubgroupID;
+  const uint wgLane = localLinearId * WARPSIZE + lane;
+  uint hhv = localLinearId / LOAD_V_VERTICAL_GROUPS;
+  const uint vvv = localLinearId % LOAD_V_VERTICAL_GROUPS;
+  if (QK_SUBGROUPS < SUBGROUP_COUNT) {
+    if (localLinearId >= QK_SUBGROUPS) {
+      hhv = hhv - QK_SUBGROUPS / LOAD_V_VERTICAL_GROUPS;
+    }
+  }
+  const uint hhm = localLinearId % LOAD_M_HORIZONTAL_GROUPS;
+  const uint vvm = localLinearId / LOAD_M_HORIZONTAL_GROUPS;
+  const uint hho = localLinearId / QK_SUBGROUPS;
+  const uint vvo = localLinearId % QK_SUBGROUPS;
+  const uint qDim = p.qHead * HEAD_DIM_QK;
+  const uint oDim = p.qHead * HEAD_DIM_PV;
+  const uint kDim = p.kStrideTok;
+  const uint vDim = p.vStrideTok;
+  const uint maskDim = p.kvSeqLen;
+  const uint offsetBaseK = (batchIdx * p.batchStrideK + kvHeadIdx * p.kStrideHead) / 4;
+  uint offsetBaseV = batchIdx * p.batchStrideV + kvHeadIdx * p.vStrideHead + hhv * TM + vvv * vDim * TK;
+  uint offsetBaseMask = (outIdx * OUTPUT_PER_WORK_GROUP + vvm * TN + lane);
+  offsetBaseMask = min(offsetBaseMask, p.activationLength - 1);
+  offsetBaseMask = offsetBaseMask * maskDim + batchIdx * p.batchStrideM;
+  if (MASK_IN_SLM) {
+    if ((EXT_FLAG & UNALIGNED_MASK_DIM) != 0) {
+      offsetBaseMask = offsetBaseMask + hhm;
+    } else if (LOAD_M_LOOPS % 4 == 0) {
+      offsetBaseMask = offsetBaseMask / 4 + hhm;
+    } else if (LOAD_M_LOOPS % 2 == 0) {
+      offsetBaseMask = offsetBaseMask / 2 + hhm;
+    } else {
+      offsetBaseMask = offsetBaseMask + hhm;
+    }
+  } else {
+    if ((EXT_FLAG & UNALIGNED_MASK_DIM) == 0) {
+      offsetBaseMask = offsetBaseMask / 4;
+    }
+  }
+  const uint offsetSlmV = (vvv * TK * HEAD_DIM_PV + hhv * TM * TK + SLM_OFFSET_BASE_V);
+  const uint offsetSlmM = ((vvm * TN + lane) * DP + SLM_OFFSET_BASE_M);
+  const uint offsetLoadSlmP = (SLM_OFFSET_BASE_P + localLinearId * TN * DP + lane * DP);
+  const uint offsetSlmLoadMaskP = (localLinearId * TN * DP + lane * DP + SLM_OFFSET_BASE_M);
+  uint offsetOut = (batchIdx * p.batchStrideO + outIdx * OUTPUT_PER_WORK_GROUP * oDim + headIdx * HEAD_DIM_PV + vvo * TN * oDim + hho * OUTPUT_DIM_PER_WARP + lane * oDim) / 4;
+  uint offsetBaseQ = outIdx * OUTPUT_PER_WORK_GROUP + vvo * TN + lane;
+  offsetBaseQ = min(offsetBaseQ, p.activationLength - 1);
+  offsetBaseQ = (offsetBaseQ * qDim + batchIdx * p.batchStrideQ + headIdx * HEAD_DIM_QK) / 8;
+  const float fp32Min = uintBitsToFloat(0xFEFFFFFF);
+  const float16_t fp16Min = float16_t(fp32Min);
+  const float fp32SinkCoeff = sinkCoeff[headIdx];
+  coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> matQ[MAT_Q_COUNT];
+  uint offsetK[LOAD_K_LOOPS];
+  uint offsetSlmK[LOAD_K_LOOPS];
+  bool maskLoadK[LOAD_K_LOOPS];
+
+  if (localLinearId < QK_SUBGROUPS) {
+    [[unroll]] for (uint i = 0; i < Q_MAT_IN_REG / 8; i++) {
+      const uint warpOffsetSlmQ = SLM_OFFSET_BASE_Q + localLinearId * Q_MAT_IN_REG * TN + lane * Q_MAT_IN_REG + i * 8;
+      mat2x4 f32TempMat = qStateF32[offsetBaseQ];
+      f32TempMat = f32TempMat * p.softMaxScale;
+      f16mat2x4 fp16TempMat = f16mat2x4(f32TempMat);
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 0] = fp16TempMat[0].x;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 1] = fp16TempMat[0].y;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 2] = fp16TempMat[0].z;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 3] = fp16TempMat[0].w;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 4] = fp16TempMat[1].x;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 5] = fp16TempMat[1].y;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 6] = fp16TempMat[1].z;
+      slm_pool_f16.slm_pool_f16[warpOffsetSlmQ + 7] = fp16TempMat[1].w;
+      offsetBaseQ = offsetBaseQ + 1;
+    }
+  }
+
+  if (localLinearId < QK_SUBGROUPS) {
