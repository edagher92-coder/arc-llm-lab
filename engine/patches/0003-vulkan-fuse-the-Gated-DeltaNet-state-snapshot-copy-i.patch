+static int ggml_vk_fuse_gdn_cache(ggml_backend_vk_context * ctx, const ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * gdn = cgraph->nodes[node_idx];
+    if (gdn->op != GGML_OP_GATED_DELTA_NET || gdn->type != GGML_TYPE_F32 ||
+        (gdn->flags & GGML_TENSOR_FLAG_OUTPUT) || !(gdn->flags & GGML_TENSOR_FLAG_COMPUTE) ||
+        !ggml_is_contiguous(gdn) || ctx->device->uma ||
+        ggml_node_get_use_count(cgraph, node_idx) != 2) {
+        return 0;
+    }
+
+    const ggml_tensor * v = gdn->src[2];
+    const int64_t K = ggml_get_op_params_i32(gdn, 0);
+    const int64_t S = v->ne[0];
+    const int64_t H = v->ne[1];
+    const int64_t T = v->ne[2];
+    if (K <= 1 || S <= 0 || S > 128 || H <= 0 || H > UINT32_MAX / (S * S) ||
+        T <= 0 || T > UINT32_MAX / (S * H) || v->ne[3] != 1) {
+        return 0;
+    }
+    const size_t D = (size_t)(S * S * H);
+    const size_t written = (size_t)std::min<int64_t>(T, K);
+    const size_t tail_off = (size_t)(S * H * T) * sizeof(float);
+    if ((uint64_t)ggml_nelements(gdn) > UINT32_MAX) {
+        return 0;
+    }
+
+    const ggml_tensor * tail = nullptr;
+    const ggml_tensor * attn = nullptr;
+    const ggml_tensor * cpy = nullptr;
+    int skip = 0;
+    // Bound the search; use counts reject any unaccounted reader outside this window.
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 12; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->src[0] == gdn) {
+            if (n->op != GGML_OP_VIEW || n->view_src != gdn || n->type != GGML_TYPE_F32) {
+                return 0;
+            }
+            if (n->view_offs == tail_off && !tail) {
+                if (!ggml_is_contiguous(n) || ggml_node_get_use_count(cgraph, j) != 1 ||
+                    (n->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_nbytes(n) != D * written * sizeof(float)) {
+                    return 0;
+                }
+                tail = n;
+            } else if (n->view_offs == 0 && !attn && ggml_nbytes(n) <= tail_off) {
+                attn = n;
+            } else {
+                return 0;
+            }
+        }
+        if (!cpy) {
+            if (n->op == GGML_OP_CPY) {
+                cpy = n;
+                skip = j - node_idx;
+            } else if (!ggml_op_is_empty(n->op)) {
+                return 0;
+            } else if ((n->flags & GGML_TENSOR_FLAG_OUTPUT) && n != attn) {
+                return 0;
+            }
+        }
+        if (cpy && tail && attn) {
+            break;
+        }
+    }
+    if (!cpy || !tail || !attn || cpy->src[0] != tail || skip >= 13 ||
+        (cpy->flags & GGML_TENSOR_FLAG_OUTPUT) || !(cpy->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+        return 0;
+    }
+
+    const ggml_tensor * cache = cpy->src[1];
+    if (!cache || cache->op != GGML_OP_VIEW || cache->type != GGML_TYPE_F32 ||
+        cache->ne[0] != (int64_t)D || cache->ne[1] != 1 || cache->ne[2] != (int64_t)written || cache->ne[3] != 1 ||
+        cache->nb[0] != sizeof(float) || cache->nb[1] != D * sizeof(float) ||
+        cache->nb[2] % sizeof(float) || cache->nb[2] < D * sizeof(float) ||
+        cache->nb[2] / sizeof(float) > UINT32_MAX / written ||
+        !cache->buffer || !cache->data || get_misalign_bytes(ctx, cache) != 0 ||
+        ggml_nbytes(cache) > ctx->device->properties.limits.maxStorageBufferRange) {
+        return 0;
+    }
+    const size_t offset = ggml_vk_tensor_buffer_offset(ctx, cache);
+    const size_t allocation = ggml_backend_buffer_get_size(cache->buffer);
+    if (offset > allocation || ggml_nbytes(cache) > allocation - offset ||
+        ggml_vk_tensors_overlap(cache, gdn, false)) {
+        return 0;
+    }
+    for (int s = 0; s < 6; ++s) {
+        if (!gdn->src[s]->buffer || ggml_vk_tensors_overlap(cache, gdn->src[s], false)) {
+            return 0;
+        }
+    }
+    return skip;
+}
