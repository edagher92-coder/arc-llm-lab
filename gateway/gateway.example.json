 "policy": {
  "read": [
   "pc_Read",
   "pc_Grep",
   "pc_Glob",
   "pc_WebFetch",
   "*_snapshot*",
   "*_screenshot*",
   "*_get_page_text",
   "*_list*",
   "*_search*",
   "*_read*",
   "*_get_*",
   "time_*",
   "context7_*",
   "docs_*",
   "fetch_fetch",
   "skills",
   "share_file",
   "agent",
   "video_workflows",
   "video_status",
   "video_result",
   "video_queue",
   "video_system",
   "video_presets"
  ],
  "write": [
   "pc_PowerShell",
   "pc_Edit",
   "pc_Write",
   "desktop_Type",
   "desktop_Click",
   "desktop_Shortcut"
  ],
  "destructive": [
   "*delete*",
   "*Delete*",
   "*DELETE*",
   "*remove*",
   "*Remove*",
   "*rmdir*",
   "*Rmdir*",
   "*trash*",
   "*Trash*",
   "*erase*",
   "*Erase*",
   "*wipe*",
   "*Wipe*",
   "*Format*"
  ],
  "default_intent": "write",
  "allow_destructive": false,
  "deny_tools": [
   "*run_code_unsafe*",
   "*browser_evaluate*",
   "*javascript_tool*"
  ],
  "deny_args": [
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "(?:^|[;|&(){}\"']|\\\\n)\\s*(remove-item|ri|rm|del|erase|rd|rmdir|clear-recyclebin)\\b",
    "why": "any delete verb as a command: recursive, forced or single-file deletes are all destructive",
    "verdict": "approval"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "\\bcmd(\\.exe)?\\s+/[ck]\\b.*\\b(del|erase|rd|rmdir)\\b",
    "why": "cmd /c delete (del /s /q, rd /s /q) bypasses the PowerShell delete verbs",
    "verdict": "approval"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "(?:^|[;|&(){}\"']|\\\\n)\\s*(clear-content|clear-disk|format-volume|format-disk|diskpart)\\b|(?:^|[;|&(){}\"']|\\\\n)\\s*(format|cipher)(\\.exe|\\.com)?\\s+(/w\\b|[a-z]:)",
    "why": "wipes or formats disks and volumes, and cipher /w free-space wipe"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "(?:^|[;|&(){}\"']|\\\\n)\\s*(vssadmin(\\.exe)?\\s+delete|bcdedit|reg(\\.exe)?\\s+(delete|add|import))\\b",
    "why": "deletes shadow copies, edits boot config, or changes the registry"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "(?:^|[;|&(){}\"']|\\\\n)\\s*(stop-computer|restart-computer|shutdown|set-executionpolicy)\\b",
    "why": "power off, reboot, or weaken the execution policy"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "\\s-(e|ec|enc|encodedcommand)(?=[\\s\"])",
    "why": "base64 encoded command hides the real payload from review"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "(?:^|[;|&(){}\"']|\\\\n)\\s*(iex|invoke-expression)\\b",
    "why": "executes an arbitrary string (covers iex with downloads such as iwr or DownloadString)"
   },
   {
    "tools": [
     "*PowerShell*",
     "*powershell*",
     "desktop_Type"
    ],
    "pattern": "(?:^|[;|&(){}\"']|\\\\n)\\s*((runas|takeown)\\b|icacls[^;|&]*\\s/(grant|reset|setowner|remove))|-verb\\s+\\W?runas",
    "why": "privilege elevation, ownership takeover, or ACL rewrite"
   },
   {
    "tools": [
     "*navigate*",
     "*tabs_create*"
    ],
    "pattern": "\\b(commbank|netbank|nab\\.com|anz\\.com|westpac|stgeorge|bankwest|bankofmelbourne|macquarie|suncorp|bendigo|hsbc|americanexpress|amex|ing\\.com|bank)\\b",
    "why": "banking sites: no navigation by agent"
   },
   {
    "tools": [
     "*navigate*",
     "*tabs_create*"
    ],
    "pattern": "\\b(paypal|stripe\\.com|squareup\\.com|zeller|afterpay|payid|tyro\\.com|sumup)\\b",
    "why": "payment dashboards and payment pages"
   },
   {
    "tools": [
     "*navigate*",
     "*tabs_create*"
    ],
    "pattern": "\\.gov\\b|servicesaustralia|\\bmygov\\b",
    "why": "government portals (myGov, ATO, Services Australia, *.gov.au)"
   },
   {
    "tools": [
     "*navigate*",
     "*tabs_create*"
    ],
    "pattern": "\\b(1password|lastpass|bitwarden|keepass|dashlane|keepersecurity)\\b|vault\\.",
    "why": "password managers and vaults"
   },
   {
    "tools": [
     "*navigate*",
     "*tabs_create*"
    ],
    "pattern": "\\/(log-?in|sign-?in|oauth2?|authorize)",
    "why": "login and credential-entry pages: stop and let the user sign in"
   },
   {
    "tools": [
     "*navigate*",
     "*tabs_create*"
    ],
    "pattern": "(\\?view=cm|[&#?]compose|\\/compose\\b|mailto:)",
    "why": "email compose or mailto links: sending mail needs an explicit go-ahead"
   },
   {
    "tools": [
     "*type*",
     "*Type*",
     "*fill*",
     "*form_input*"
    ],
    "pattern": "\"(element|name|label|field|description|placeholder)\"\\s*:\\s*\"[^\"]*(password|passwd|passcode|\\bpin\\b|\\botp\\b|one.?time|verification code|2fa|mfa)|\"type\"\\s*:\\s*\"password\"",
    "why": "typing into password, PIN, OTP or MFA fields"
   },
   {
    "tools": [
     "*Shortcut*",
     "*shortcut*"
    ],
    "pattern": "\\b(win|windows|meta|super)\\s*[+ ]\\s*r\\b|\\balt\\s*[+ ]\\s*f4\\b|\\bctrl\\s*[+ ]\\s*alt\\s*[+ ]\\s*del(ete)?\\b|\\bctrl\\s*[+ ]\\s*shift\\s*[+ ]\\s*esc\\b|\\b(win|windows)\\s*[+ ]\\s*x\\b|\"(win|windows|meta)\"\\s*,\\s*\"r\"|\"alt\"\\s*,\\s*\"f4\"",
    "why": "Run dialog (win+r), close window (alt+f4), power-user menu, Task Manager and Secure Attention keys"
   },
   {
    "tools": [
     "*"
    ],
    "pattern": "approvals|:8093|approval-pin|C:[/\\\\\\\\]+AI[/\\\\\\\\]+gateway",
    "why": "the approval page and the gateway's own files are off limits to the model"
   }
  ],
  "max_identical_calls": 3,
  "max_calls_per_window": 40,
  "loop_window_s": 60,
  "per_tool_limits": {
   "desktop_*": 20,
   "chrome_*": 30,
