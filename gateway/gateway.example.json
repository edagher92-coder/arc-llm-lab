  },
  "confirm_intents": [
   "write",
   "destructive"
  ],
  "max_result_chars": 12000,
  "_comment_agent": "agent is read: the tool itself changes nothing; each inner call goes back through Guard (approvals, deny rules, audit), so a write inside it pauses for approval."
 },
 "descriptions": {
  "search_tools": "Find a tool when none shown fits: shell, edit or write files, browser, desktop, docs, PDF. Query = a few nouns, e.g. 'run shell command'. Then call_tool with the exact name and arguments matching input_schema.",
  "call_tool": "Run a tool found by search_tools. name = exact tool name; arguments = object matching its input_schema. One call per step. If it says NEEDS APPROVAL, tell the user, then repeat the same call once after they approve.",
  "skills": "Your playbooks (ops, releases, debugging). action 'search' with a few words first, then action 'load' with the exact skill name (query) and follow it.",
  "agent": "Do a whole multi-step job on the PC in one go (build a website, research, fix and test). task = the job in plain words. Returns status, summary, links. If status is paused, tell the user to approve, then agent(resume=id).",
  "share_file": "Give the user a link to a file or folder you made (website, report, zip). path = full Windows path under C:\\AI\\shared. Always use this instead of telling them a server path.",
  "pc_Read": "Read a file. Give file_path (absolute) and use offset/limit for big files; do not read whole large files.",
  "pc_Grep": "Search file contents with a regex. Prefer this to reading many files. Give pattern and path; use glob to limit file types.",
  "pc_Glob": "List files by pattern, e.g. **/*.py. Use it to locate a file before reading it.",
  "fetch_fetch": "Fetch a web page as text. url required; use max_length and start_index to page through long pages.",
  "time_get_current_time": "Get the current time. timezone defaults to Australia/Sydney."
 },
